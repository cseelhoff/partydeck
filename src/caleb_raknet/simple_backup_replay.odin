package caleb_raknet

// Replay the pretty-printed backup_predict.json transaction file through the new
// simple_net request dispatcher. The output keeps the same record format and raw
// sent/real bytes, but replaces pred/pred_human_readable with values generated by
// get_response_from_request.

import "core:encoding/hex"
import "core:encoding/json"
import "core:fmt"
import "core:mem"
import "core:net"
import "core:os"
import "core:strings"

Simple_Backup_Record :: struct {
	t:                    string,
	peer:                 string,
	match:                bool,
	sent:                 []string,
	sent_human_readable:  string,
	real_human_readable:  string,
	pred_human_readable:  string,
	real:                 []string,
	pred:                 []string,
}

Simple_Backup_Client :: struct {
	label:     string,
	client_id: int,
	state:     ^Simple_Server_State,
}

simple_backup_replay :: proc(path: string, out_path := SIMPLE_DEFAULT_PREDICT_FILE) -> Error {
	data := os.read_entire_file_from_path(path, context.allocator) or_return
	defer delete(data)

	scratch_backing := make([]byte, 128 * 1024 * 1024)
	defer delete(scratch_backing)
	scratch_arena: mem.Arena
	mem.arena_init(&scratch_arena, scratch_backing)
	scratch := mem.arena_allocator(&scratch_arena)
	defer free_all(scratch)

	simple_scene_infos_load(scratch) or_return
	if g_simple_party_scene_by_invite == nil do g_simple_party_scene_by_invite = make(map[string]string, scratch)
	if g_simple_party_owner_by_invite == nil do g_simple_party_owner_by_invite = make(map[string]string, scratch)
	if g_simple_client_id_by_user_id == nil do g_simple_client_id_by_user_id = make(map[string]int, scratch)
	if g_simple_steam_lobby_by_party_scene == nil do g_simple_steam_lobby_by_party_scene = make(map[string]u64, scratch)
	if g_simple_steam_lobby_by_invite == nil do g_simple_steam_lobby_by_invite = make(map[string]u64, scratch)
	g_simple_latest_party_steam_lobby_id = 0

	out := strings.builder_make(scratch)
	peers: [dynamic]^Peer_State
	clients: [dynamic]Simple_Backup_Client
	nidx := 1
	record_count := 0
	match_count := 0

	text := string(data)
	seed_missing_scene_connections := !strings.contains(text, "Connect_To_Scene")
	for object_text in simple_backup_json_objects(text, scratch) {
		rec: Simple_Backup_Record
		if json.unmarshal_string(object_text, &rec, allocator = scratch) != nil do continue

		ps := find_peer(&peers, rec.peer, &nidx)
		client := simple_backup_client_for_peer(&clients, rec.peer, ps.ep_client)

		sent_bytes := simple_backup_hex_array(rec.sent, scratch)
		real_bytes := simple_backup_hex_array(rec.real, scratch)
		sent_decoded := simple_backup_decode_for_sender(&ps.reg_real, ps.ep_client, sent_bytes, scratch)
		real_seed_decoded := simple_backup_decode_for_sender(&ps.reg_real, ps.ep_real, real_bytes, scratch)
		simple_backup_seed_real_values(client.state, real_seed_decoded[:], seed_missing_scene_connections)
		pred_generated := make([dynamic]Decoded_Message, scratch)

		for sent_msg in sent_decoded {
			partial := get_response_from_request(
				client.client_id,
				rec.peer,
				sent_msg,
				false,
				client.state,
			) or_continue
			for response in partial do append(&pred_generated, response)
		}

		pred_bytes := simple_backup_encode_generated(pred_generated[:], scratch)
		pred_decoded := simple_backup_decode_for_sender(&ps.reg_pred, ps.ep_pred, pred_bytes, scratch)
		real_decoded := simple_backup_decode_for_sender(&ps.reg_real, ps.ep_real, real_bytes, scratch)
		real_human := render_decoded_burst(&ps.reg_real, ps.ep_real, real_decoded[:], scratch)
		pred_human := render_decoded_burst(&ps.reg_pred, ps.ep_pred, pred_decoded[:], scratch)
		match := decoded_messages_match(real_decoded[:], pred_decoded[:], scratch)
		if match do match_count += 1
		record_count += 1

		sync_write_record(
			&out,
			rec.t,
			rec.peer,
			match,
			sent_bytes,
			real_bytes,
			pred_bytes,
			rec.sent_human_readable,
			real_human,
			pred_human,
		)
	}

	sync_write_out(out_path, strings.to_string(out))
	fmt.printfln("simple-backup wrote %d records (%d match) -> %s", record_count, match_count, out_path)
	return nil
}

simple_backup_client_for_peer :: proc(
	clients: ^[dynamic]Simple_Backup_Client,
	label: string,
	remote: net.Endpoint,
) -> Simple_Backup_Client {
	for client in clients^ {
		if client.label == label do return client
	}
	client_id := len(clients^) + 1
	state := new(Simple_Server_State)
	state.remote = remote
	client := Simple_Backup_Client{
		label = strings.clone(label),
		client_id = client_id,
		state = state,
	}
	append(clients, client)
	return client
}

simple_backup_json_objects :: proc(text: string, allocator := context.allocator) -> []string {
	out := make([dynamic]string, allocator)
	depth := 0
	start := -1
	in_string := false
	escaped := false
	for ch, i in text {
		if in_string {
			if escaped {
				escaped = false
			} else if ch == '\\' {
				escaped = true
			} else if ch == '"' {
				in_string = false
			}
			continue
		}
		if ch == '"' {
			in_string = true
		} else if ch == '{' {
			if depth == 0 do start = i
			depth += 1
		} else if ch == '}' {
			depth -= 1
			if depth == 0 && start >= 0 {
				append(&out, text[start:i + 1])
				start = -1
			}
		}
	}
	return out[:]
}

simple_backup_hex_array :: proc(values: []string, allocator := context.allocator) -> [][]byte {
	out := make([dynamic][]byte, allocator)
	for value in values {
		decoded, ok := hex.decode(transmute([]byte)value, allocator)
		if ok do append(&out, decoded)
	}
	return out[:]
}

simple_backup_decode_for_sender :: proc(
	reg: ^Route_Registry,
	ep: net.Endpoint,
	messages: [][]byte,
	allocator := context.allocator,
) -> []Decoded_Message {
	out := make([dynamic]Decoded_Message, allocator)
	for msg in messages {
		decoded := decode_message(msg, allocator)
		route_registry_observe(reg, ep, decoded, allocator)
		if sm, ok := decoded.(Scene_Message); ok {
			route_name := route_registry_resolve(reg, ep, sm.scene_handle, sm.route_handle)
			decoded = scene_message_with_route_body(decoded, route_name, allocator)
		}
		append(&out, decoded)
	}
	return out[:]
}

simple_backup_seed_real_values :: proc(
	state: ^Simple_Server_State,
	messages: []Decoded_Message,
	seed_scene_connections: bool,
) {
	pending_token_scene := ""
	pending_scene_infos := make([dynamic]string, context.temp_allocator)
	for msg in messages {
		#partial switch sm in msg {
		case Response_Msg:
			#partial switch body in sm.data {
			case Scene_Infos:
				if seed_scene_connections do append(&pending_scene_infos, scene_suffix(body.scene_id))
			case Scene_Connection_Result:
				if seed_scene_connections do simple_backup_seed_scene_connection_result(state, body, pending_token_scene, &pending_scene_infos)
				pending_token_scene = ""
			}
		case Scene_Message:
			#partial switch body in sm.body {
			case Stormancer_Rpc_Next_Body:
				if body.kind == .Scene_Connection_Token && body.token_scene != "" {
					pending_token_scene = body.token_scene
				}
				if body.kind == .Scene_Connection_Token && body.token.content_type == "stormancer/userSession" && len(body.token.user_data) > 0 {
					state.user_session_data_override = body.token.user_data
				}
				if body.kind == .Scene_Connection_Token && strings.has_prefix(body.token_scene, "party-") {
					state.party_scene_override = body.token_scene
					state.party_create_session_tail = body.raw_tail
				}
			}
		}
	}
}

simple_backup_seed_scene_connection_result :: proc(
	state: ^Simple_Server_State,
	result: Scene_Connection_Result,
	pending_token_scene: string,
	pending_scene_infos: ^[dynamic]string,
) {
	handle := scene_connection_result_handle(result)
	if handle < u64(SCENE_HANDLE_MIN) do return
	scene := simple_backup_scene_for_connection_result(result, pending_token_scene, pending_scene_infos, state)
	if scene == "" do return
	idx := int(handle - u64(SCENE_HANDLE_MIN))
	if idx < len(state.scenes) && state.scenes[idx].scene_id != "" do return
	if idx > len(state.scenes) do return
	if idx == len(state.scenes) do append(&state.scenes, Simple_Scene{})
	state.scenes[idx] = Simple_Scene{scene_id = scene, routes = result.routes}
}

simple_backup_scene_for_connection_result :: proc(
	result: Scene_Connection_Result,
	pending_token_scene: string,
	pending_scene_infos: ^[dynamic]string,
	state: ^Simple_Server_State,
) -> string {
	if simple_backup_routes_have(result.routes, "gameVersion.update") do return simple_backup_pop_scene_or(pending_scene_infos, "authenticator")
	if simple_backup_routes_have(result.routes, "friends.notification") do return simple_backup_pop_scene_or(pending_scene_infos, "friends")
	if simple_backup_routes_have(result.routes, "gamefinder.update") do return simple_backup_pop_scene_or(pending_scene_infos, "matchmaking")
	if simple_backup_routes_have(result.routes, "player.update") do return simple_backup_pop_scene_or(pending_scene_infos, "gamesession")
	if simple_backup_routes_have(result.routes, "party.memberConnected") {
		simple_backup_pop_scene_or(pending_scene_infos, "")
		if state.party_scene_override != "" do return state.party_scene_override
		if pending_token_scene != "" do return pending_token_scene
		return "party-replay"
	}
	if len(pending_scene_infos^) > 0 do return simple_backup_pop_scene_or(pending_scene_infos, "")
	if pending_token_scene != "" do return pending_token_scene
	return ""
}

simple_backup_pop_scene_or :: proc(pending_scene_infos: ^[dynamic]string, fallback: string) -> string {
	if len(pending_scene_infos^) == 0 do return fallback
	scene := pending_scene_infos[0]
	for i := 1; i < len(pending_scene_infos^); i += 1 {
		pending_scene_infos[i - 1] = pending_scene_infos[i]
	}
	resize(pending_scene_infos, len(pending_scene_infos^) - 1)
	if scene != "" do return scene
	return fallback
}

simple_backup_routes_have :: proc(routes: Routes, route_name: string) -> bool {
	for route in routes {
		if route == route_name do return true
	}
	return false
}

simple_backup_encode_generated :: proc(
	messages: []Decoded_Message,
	allocator := context.allocator,
) -> [][]byte {
	out := make([dynamic][]byte, allocator)
	for msg in messages do append(&out, encode_message(msg, allocator))
	return out[:]
}
