package caleb_raknet

// Replay the pretty-printed backup_predict.json transaction file through the new
// simple_net request dispatcher. The output keeps the same record format and raw
// sent/real bytes, but replaces pred/pred_human_readable with values generated by
// get_response_from_request.

import "core:encoding/hex"
import "core:encoding/json"
import "core:fmt"
import "core:mem"
import "core:net"
import "core:os"
import "core:strings"

Simple_Backup_Record :: struct {
	t:                    string,
	peer:                 string,
	match:                bool,
	sent:                 []string,
	sent_human_readable:  string,
	real_human_readable:  string,
	pred_human_readable:  string,
	real:                 []string,
	pred:                 []string,
}

Simple_Backup_Client :: struct {
	label:     string,
	client_id: int,
	state:     ^Simple_Server_State,
}

simple_backup_replay :: proc(path: string, out_path := SIMPLE_DEFAULT_PREDICT_FILE) -> Error {
	data := os.read_entire_file_from_path(path, context.allocator) or_return
	defer delete(data)

	scratch_backing := make([]byte, 128 * 1024 * 1024)
	defer delete(scratch_backing)
	scratch_arena: mem.Arena
	mem.arena_init(&scratch_arena, scratch_backing)
	scratch := mem.arena_allocator(&scratch_arena)
	defer free_all(scratch)

	simple_scene_infos_load(scratch) or_return
	if g_simple_party_scene_by_invite == nil do g_simple_party_scene_by_invite = make(map[string]string, scratch)
	if g_simple_steam_lobby_by_party_scene == nil do g_simple_steam_lobby_by_party_scene = make(map[string]u64, scratch)
	if g_simple_steam_lobby_by_invite == nil do g_simple_steam_lobby_by_invite = make(map[string]u64, scratch)
	g_simple_latest_party_steam_lobby_id = 0

	out := strings.builder_make(scratch)
	peers: [dynamic]^Peer_State
	clients: [dynamic]Simple_Backup_Client
	nidx := 1
	record_count := 0
	match_count := 0

	text := string(data)
	for object_text in simple_backup_json_objects(text, scratch) {
		rec: Simple_Backup_Record
		if json.unmarshal_string(object_text, &rec, allocator = scratch) != nil do continue

		ps := find_peer(&peers, rec.peer, &nidx)
		client := simple_backup_client_for_peer(&clients, rec.peer, ps.ep_client)

		sent_bytes := simple_backup_hex_array(rec.sent, scratch)
		real_bytes := simple_backup_hex_array(rec.real, scratch)
		sent_decoded := simple_backup_decode_for_sender(&ps.reg_real, ps.ep_client, sent_bytes, scratch)
		pred_generated := make([dynamic]Decoded_Message, scratch)

		for sent_msg in sent_decoded {
			partial := get_response_from_request(
				client.client_id,
				rec.peer,
				sent_msg,
				false,
				client.state,
			) or_continue
			for response in partial do append(&pred_generated, response)
		}

		pred_bytes := simple_backup_encode_generated(pred_generated[:], scratch)
		pred_decoded := simple_backup_decode_for_sender(&ps.reg_pred, ps.ep_pred, pred_bytes, scratch)
		real_decoded := simple_backup_decode_for_sender(&ps.reg_real, ps.ep_real, real_bytes, scratch)
		pred_human := render_decoded_burst(&ps.reg_pred, ps.ep_pred, pred_decoded[:], scratch)
		match := decoded_messages_match(real_decoded[:], pred_decoded[:], scratch)
		if match do match_count += 1
		record_count += 1

		sync_write_record(
			&out,
			rec.t,
			rec.peer,
			match,
			sent_bytes,
			real_bytes,
			pred_bytes,
			rec.sent_human_readable,
			rec.real_human_readable,
			pred_human,
		)
	}

	sync_write_out(out_path, strings.to_string(out))
	fmt.printfln("simple-backup wrote %d records (%d match) -> %s", record_count, match_count, out_path)
	return nil
}

simple_backup_client_for_peer :: proc(
	clients: ^[dynamic]Simple_Backup_Client,
	label: string,
	remote: net.Endpoint,
) -> Simple_Backup_Client {
	for client in clients^ {
		if client.label == label do return client
	}
	client_id := len(clients^) + 1
	state := new(Simple_Server_State)
	state.remote = remote
	client := Simple_Backup_Client{
		label = strings.clone(label),
		client_id = client_id,
		state = state,
	}
	append(clients, client)
	return client
}

simple_backup_json_objects :: proc(text: string, allocator := context.allocator) -> []string {
	out := make([dynamic]string, allocator)
	depth := 0
	start := -1
	in_string := false
	escaped := false
	for ch, i in text {
		if in_string {
			if escaped {
				escaped = false
			} else if ch == '\\' {
				escaped = true
			} else if ch == '"' {
				in_string = false
			}
			continue
		}
		if ch == '"' {
			in_string = true
		} else if ch == '{' {
			if depth == 0 do start = i
			depth += 1
		} else if ch == '}' {
			depth -= 1
			if depth == 0 && start >= 0 {
				append(&out, text[start:i + 1])
				start = -1
			}
		}
	}
	return out[:]
}

simple_backup_hex_array :: proc(values: []string, allocator := context.allocator) -> [][]byte {
	out := make([dynamic][]byte, allocator)
	for value in values {
		decoded, ok := hex.decode(transmute([]byte)value, allocator)
		if ok do append(&out, decoded)
	}
	return out[:]
}

simple_backup_decode_for_sender :: proc(
	reg: ^Route_Registry,
	ep: net.Endpoint,
	messages: [][]byte,
	allocator := context.allocator,
) -> []Decoded_Message {
	out := make([dynamic]Decoded_Message, allocator)
	for msg in messages {
		decoded := decode_message(msg, allocator)
		route_registry_observe(reg, ep, decoded, allocator)
		if sm, ok := decoded.(Scene_Message); ok {
			route_name := route_registry_resolve(reg, ep, sm.scene_handle, sm.route_handle)
			decoded = scene_message_with_route_body(decoded, route_name, allocator)
		}
		append(&out, decoded)
	}
	return out[:]
}

simple_backup_encode_generated :: proc(
	messages: []Decoded_Message,
	allocator := context.allocator,
) -> [][]byte {
	out := make([dynamic][]byte, allocator)
	for msg in messages do append(&out, encode_message(msg, allocator))
	return out[:]
}
